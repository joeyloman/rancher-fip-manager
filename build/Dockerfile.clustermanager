FROM docker.io/golang:1.26-alpine3.24 AS builder
RUN mkdir /src /deps
RUN apk update && apk add git build-base binutils-gold
WORKDIR /deps
ADD go.mod go.sum /deps/
ADD clustermanager/go.mod clustermanager/go.sum /deps/clustermanager/
WORKDIR /deps/clustermanager
RUN go mod download
ADD / /src
WORKDIR /src/clustermanager
RUN go build -a -o rancher-fip-cluster-manager cmd/cluster-manager/main.go
FROM docker.io/alpine:3.24
RUN adduser -S -D -H -h /app rancher-fip-cluster-manager
USER rancher-fip-cluster-manager
COPY --from=builder /src/clustermanager/rancher-fip-cluster-manager /app/
WORKDIR /app
ENTRYPOINT ["./rancher-fip-cluster-manager"]

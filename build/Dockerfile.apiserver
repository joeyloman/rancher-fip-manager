FROM docker.io/golang:1.26-alpine3.24 AS builder
RUN mkdir /src /deps
RUN apk update && apk add git build-base binutils-gold
WORKDIR /deps
ADD go.mod go.sum /deps/
ADD apiserver/go.mod apiserver/go.sum /deps/apiserver/
WORKDIR /deps/apiserver
RUN go mod download
ADD / /src
WORKDIR /src/apiserver
RUN go build -a -o rancher-fip-api-server cmd/api-server/main.go
FROM docker.io/alpine:3.24
RUN adduser -S -D -H -h /app rancher-fip-api-server
USER rancher-fip-api-server
COPY --from=builder /src/apiserver/rancher-fip-api-server /app/
WORKDIR /app
ENTRYPOINT ["./rancher-fip-api-server"]
